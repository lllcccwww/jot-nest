{
  "name": "jot-nest",
  "version": "0.1.0",
  "description": "Jot — 桌面便签画布",
  "main": "./out/main/index.js",
  "author": "linchengwei",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win",
    "verify": "node tools/verify.mjs",
    "icon": "node tools/make-icon.mjs"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^2.14.7",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "lucide-react": "^0.549.0",
    "playwright-core": "^1.65.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
